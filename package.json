{
    "name": "dwelin-blog",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Dwelin Blog Frontend - Vue 3 + TypeScript + Tailwind CSS",
    "keywords": ["vue", "typescript", "blog", "frontend", "tailwindcss"],
    "scripts": {
        "dev": "NODE_OPTIONS='--no-warnings' vite",
        "build": "vite build",
        "preview": "vite preview",
        "build:low-spec": "NODE_OPTIONS='--max-old-space-size=1536' npm run build",
        "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
        "format": "prettier --write src/",
        "type-check": "vue-tsc --noEmit"
    },
    "dependencies": {
        "@vueuse/core": "^10.6.1",
        "axios": "^1.6.2",
        "dayjs": "^1.11.10",
        "pinia": "^2.1.7",
        "pinia-plugin-persistedstate": "^3.2.0",
        "vue": "^3.4.0",
        "vue-router": "^4.2.5",
        "vue-i18n": "^9.8.0"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "@vitejs/plugin-vue": "^4.6.2",
        "@vitejs/plugin-vue-jsx": "^3.1.0",
        "autoprefixer": "^10.4.17",
        "eslint": "^8.55.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.0.1",
        "eslint-plugin-vue": "^9.19.2",
        "postcss": "^8.4.35",
        "prettier": "^3.1.0",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.3.3",
        "unplugin-vue-setup-extend-plus": "^1.0.0",
        "vite": "^5.4.18",
        "vue-tsc": "^1.8.24"
    },
    "engines": {
        "node": ">=18.0.0",
        "npm": ">=8.0.0"
    },
    "browserslist": [
        "> 1%",
        "last 2 versions",
        "not dead"
    ]
}
